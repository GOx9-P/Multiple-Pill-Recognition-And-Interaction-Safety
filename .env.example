# PostgreSQL (Docker Container) Credentials
POSTGRES_DB=medication_db
POSTGRES_USER=medication_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433

# Database Connection URL (Option 1: PostgreSQL on Docker - Port 5433)
DATABASE_URL=postgresql+psycopg://medication_user:change_me@localhost:5433/medication_db

# Database Connection URL (Option 2: SQLite Local Fallback)
# DATABASE_URL=sqlite:///pill_safety.db

# LLM Generator Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here


